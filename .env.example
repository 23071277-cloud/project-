# ==============================================================================
# BRAND COMPLIANCE AI PLATFORM - ENVIRONMENT CONFIGURATION
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN BRAND COMPLIANCE AI
# ==============================================================================
# Instructions / Hướng dẫn:
# 1. Copy this file to .env: `cp .env.example .env`
#    Sao chép file này thành .env: `cp .env.example .env`
# 2. Fill in your credentials and keys.
#    Điền đầy đủ thông tin xác thực và khóa bí mật của bạn.
# 3. DO NOT commit the .env file to public version control!
#    TUYỆT ĐỐI KHÔNG commit file .env chứa khóa bí mật lên Git công khai!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & WORDPRESS SETTINGS / CẤU HÌNH ỨNG DỤNG & WORDPRESS
# ------------------------------------------------------------------------------
WP_ENV=development                       # development | staging | production
WP_DEBUG=true                            # Bật chế độ debug (true | false)
WP_DEBUG_LOG=true                        # Ghi log lỗi vào wp-content/debug.log
WP_DEBUG_DISPLAY=false                   # Không in lỗi trực tiếp ra màn hình người dùng
SCRIPT_DEBUG=false                       # Sử dụng file CSS/JS minify

WP_HOME=https://dev-brandcompliance-v2.pantheonsite.io
WP_SITEURL=https://dev-brandcompliance-v2.pantheonsite.io

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION / CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL
# ------------------------------------------------------------------------------
DB_NAME=pantheon
DB_USER=pantheon
DB_PASSWORD=your_database_password_here
DB_HOST=127.0.0.1:3306
DB_CHARSET=utf8mb4
DB_COLLATE=
DB_PREFIX=wp_

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI MULTIMODAL VISION AI / CẤU HÌNH GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
# Lấy miễn phí tại / Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere_OrServiceAccountKey
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite   # gemini-3.5-flash-lite | gemini-3.6-flash | gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30                    # Thời gian chờ tối đa khi tải và phân tích ảnh (giây)
GEMINI_FALLBACK_MOCK=true                    # Tự động chuyển Mock Engine nếu API Google gặp sự cố

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL & NOTIFICATIONS / CẤU HÌNH GỬI MAIL SMTP
# ------------------------------------------------------------------------------
# Sử dụng Gmail SMTP với Mật khẩu ứng dụng 16 ký tự (Google App Password)
# Cách tạo: Google Account > Security > 2-Step Verification > App passwords
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                                # 587 (TLS/STARTTLS) hoặc 465 (SSL)
SMTP_ENCRYPTION=tls                          # tls | ssl
SMTP_AUTH=true
SMTP_USERNAME=hoanganhle0320@gmail.com        # Email tài khoản Google của bạn
SMTP_PASSWORD=your_16_char_app_password_here # Mật khẩu ứng dụng 16 ký tự (không có khoảng trắng)
SMTP_FROM_EMAIL=hoanganhle0320@gmail.com
SMTP_FROM_NAME="Brand Compliance AI Platform"
SMTP_FORCE_FROM_EMAIL=true
SMTP_FORCE_FROM_NAME=true

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (LOG IN WITH GOOGLE) / ĐĂNG NHẬP BẰNG GOOGLE
# ------------------------------------------------------------------------------
# Tạo tại / Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://dev-brandcompliance-v2.pantheonsite.io/wp-login.php?loginSocial=google

# ------------------------------------------------------------------------------
# 6. MAKER-CHECKER COMPLIANCE ENGINE SETTINGS / CẤU HÌNH ĐIỀU LỆ TUÂN THỦ
# ------------------------------------------------------------------------------
COMPLIANCE_SCORE_PASS_MIN=71                 # Điểm tối thiểu để ĐẠT (PASS): >= 71
COMPLIANCE_SCORE_NEEDS_LOOK_MIN=31           # Điểm cần xem xét lại (NEEDS_LOOK): 31 - 70
COMPLIANCE_SCORE_FAIL_MAX=30                 # Điểm không đạt (FAIL): <= 30
COMPLIANCE_PROMPT_VERSION=v1.2
COMPLIANCE_AUTO_TRANSITION_IN_REVIEW=true    # Tự động đổi trạng thái sang 'in_review' sau khi AI chấm xong
COMPLIANCE_CACHE_TTL_DAYS=30                 # Thời gian lưu cache kết quả chấm điểm (ngày)
